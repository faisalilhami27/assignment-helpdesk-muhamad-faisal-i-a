# Salin file ini menjadi .env lalu isi dengan API key milik Anda sendiri.
# JANGAN commit file .env ke repository (sudah tercantum di .gitignore).

# Wajib — API key Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional — override model & parameter RAG (nilai di bawah adalah default)
GEMINI_MODEL=gemini-3.8-flash-lite-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=3
RAG_MIN_SCORE=0.7
